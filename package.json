{
  "name": "se-eval",
  "version": "0.1.0",
  "description": "Evaluationstool für den Vergleich klassischer und agentischer Softwareentwicklung (WPM SE mit generativen KI-Agenten, HS Flensburg)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "se-eval": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "author": "Team Ackermann/Temme/Carzow",
  "license": "MIT",
  "dependencies": {
    "commander": "15.0.0",
    "csv-parse": "7.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "jscpd": "5.4.0",
    "picomatch": "4.0.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/picomatch": "4.0.3",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  },
  "private": true,
  "type": "module",
  "bin": {
    "se-eval": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
